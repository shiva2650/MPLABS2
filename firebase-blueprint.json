{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["mp", "admin", "agency", "citizen"] },
        "constituency": { "type": "string", "maxLength": 128 },
        "state": { "type": "string", "maxLength": 128 },
        "district": { "type": "string", "maxLength": 128 },
        "agencyId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "name", "role"]
    },
    "Project": {
      "title": "Project",
      "description": "MPLADS development work record",
      "type": "object",
      "properties": {
        "workId": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "maxLength": 100 },
        "mpId": { "type": "string", "maxLength": 128 },
        "mpName": { "type": "string", "maxLength": 128 },
        "house": { "type": "string", "enum": ["Lok Sabha", "Rajya Sabha"] },
        "state": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "constituency": { "type": "string", "maxLength": 100 },
        "estimatedCost": { "type": "number" },
        "sanctionedCost": { "type": "number" },
        "utilizedCost": { "type": "number" },
        "status": { "type": "string", "enum": ["Recommended", "Under Review", "Sanctioned", "Assigned", "Ongoing", "Delayed", "Completed", "Rejected"] },
        "agencyId": { "type": "string", "maxLength": 128 },
        "agencyName": { "type": "string", "maxLength": 150 },
        "vendorName": { "type": "string", "maxLength": 150 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "locationAddress": { "type": "string", "maxLength": 300 },
        "financialYear": { "type": "string", "maxLength": 16 },
        "riskScore": { "type": "number" },
        "riskLevel": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
        "completionPercentage": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["workId", "title", "category", "mpId", "state", "district", "estimatedCost", "status"]
    },
    "Alert": {
      "title": "Alert",
      "description": "Risk and anomaly detection alert for human review",
      "type": "object",
      "properties": {
        "alertId": { "type": "string", "maxLength": 64 },
        "projectId": { "type": "string", "maxLength": 64 },
        "projectTitle": { "type": "string", "maxLength": 300 },
        "type": { "type": "string", "enum": ["High Risk", "Cost Anomaly", "Delay Risk", "Possible Duplicate", "Photo Anomaly", "Location Mismatch"] },
        "riskLevel": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
        "reason": { "type": "string", "maxLength": 600 },
        "status": { "type": "string", "enum": ["Open", "Under Review", "Valid", "False Positive", "Needs More Info", "Escalated"] },
        "assignedOfficer": { "type": "string", "maxLength": 128 },
        "reviewNotes": { "type": "string", "maxLength": 1000 },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "reviewedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["alertId", "projectId", "type", "riskLevel", "reason", "status", "createdAt"]
    },
    "CitizenFeedback": {
      "title": "CitizenFeedback",
      "description": "Public feedback and grievance on MPLADS works",
      "type": "object",
      "properties": {
        "feedbackId": { "type": "string", "maxLength": 64 },
        "projectId": { "type": "string", "maxLength": 64 },
        "workTitle": { "type": "string", "maxLength": 300 },
        "issueType": { "type": "string", "enum": ["incomplete work", "wrong location", "asset not found", "damaged asset", "other"] },
        "citizenName": { "type": "string", "maxLength": 128 },
        "contactEmail": { "type": "string", "maxLength": 128 },
        "comments": { "type": "string", "maxLength": 1000 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["Pending", "Reviewed", "Resolved", "Dismissed"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["feedbackId", "projectId", "issueType", "comments", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only historical audit trail for integrity tracking",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "maxLength": 64 },
        "projectId": { "type": "string", "maxLength": 64 },
        "action": { "type": "string", "maxLength": 128 },
        "actorId": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 128 },
        "actorRole": { "type": "string", "maxLength": 64 },
        "fieldChanged": { "type": "string", "maxLength": 64 },
        "previousValue": { "type": "string", "maxLength": 500 },
        "newValue": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["logId", "projectId", "action", "actorId", "actorRole", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and RBAC assignment"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "MPLADS developmental work documents"
    },
    "/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/Alert" },
      "description": "AI-detected anomaly and integrity review alerts"
    },
    "/feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/CitizenFeedback" },
      "description": "Citizen public feedback and grievance logs"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable append-only audit trail logs"
    }
  }
}
