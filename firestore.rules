rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserRole() == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isMP() {
      return isSignedIn() && (getUserRole() == 'mp' || exists(/databases/$(database)/documents/mps/$(request.auth.uid)));
    }

    function isAgency() {
      return isSignedIn() && (getUserRole() == 'agency' || exists(/databases/$(database)/documents/agencies/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && !('role' in request.resource.data && request.resource.data.role == 'admin');
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'agencyId', 'constituency']))
      );
      allow delete: if isAdmin();
    }

    // Projects: Public can read, authenticated roles have strict scoped access
    match /projects/{projectId} {
      // Public read for transparent eSAKSHI citizen monitoring
      allow get, list: if true;

      // MP can recommend works
      allow create: if isSignedIn() && (
        isAdmin() ||
        (isMP() && request.resource.data.mpId == request.auth.uid && request.resource.data.status == 'Recommended')
      );

      // Updates are partitioned by role:
      // - Admin: can modify status, sanctions, assign agency, risk review
      // - Agency: can only update progress, photos, and expenditure on assigned project
      // - MP: cannot modify admin decisions or agency financials
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isAgency() && resource.data.agencyId == request.auth.uid && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completionPercentage', 'utilizedCost', 'photos', 'progressLogs', 'updatedAt'])) ||
        (isMP() && resource.data.mpId == request.auth.uid && resource.data.status == 'Recommended' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'category', 'estimatedCost', 'description', 'updatedAt']))
      );

      allow delete: if isAdmin();
    }

    // Alerts: Admin only management; MPs can view for their constituency
    match /alerts/{alertId} {
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        isMP()
      );
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNotes', 'reviewedBy', 'reviewedAt', 'assignedOfficer']);
      allow delete: if isAdmin();
    }

    // Citizen Feedback: Public can create, Admins can review/resolve
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasAll(['projectId', 'issueType', 'comments', 'createdAt']) &&
        request.resource.data.comments.size() <= 1500;
      allow read: if true;
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isAdmin();
    }

    // Audit Logs: Append-only, strict immutability. Nobody can update or delete audit logs.
    match /auditLogs/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Strict append-only invariant
    }
  }
}
