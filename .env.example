# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"
# JWT_SECRET: Cryptographic signing secret for administrative session authentication.
JWT_SECRET="replace_with_a_secure_random_256_bit_entropy_secret_in_production"

# --- LIVE DATA INGESTION (eSAKSHI & data.gov.in) ---
# DATA_GOV_IN_API_KEY: API key for Government Open Data (data.gov.in)
DATA_GOV_IN_API_KEY=""
# DATA_GOV_IN_RESOURCE_ID: Target MPLADS dataset resource UID on data.gov.in
DATA_GOV_IN_RESOURCE_ID=""
# ESAKSHI_API_URL: Official MoSPI eSAKSHI REST API endpoint for work orders
ESAKSHI_API_URL="https://mplads.mospi.gov.in/api/v1"
# ESAKSHI_API_TOKEN: Bearer token or mTLS credential for eSAKSHI integration
ESAKSHI_API_TOKEN=""

# --- SATELLITE IMAGERY INTEGRATION (Sentinel Hub / GEE) ---
# SENTINEL_HUB_CLIENT_ID: Sentinel Hub OAuth2 Client ID (Copernicus Data Space)
SENTINEL_HUB_CLIENT_ID=""
# SENTINEL_HUB_CLIENT_SECRET: Sentinel Hub OAuth2 Client Secret
SENTINEL_HUB_CLIENT_SECRET=""
# SENTINEL_HUB_INSTANCE_ID: Sentinel Hub Configuration Instance ID
SENTINEL_HUB_INSTANCE_ID=""
# GEE_SERVICE_ACCOUNT_KEY: Path or JSON string of Google Earth Engine service account credentials
GEE_SERVICE_ACCOUNT_KEY=""
# GEE_PROJECT_ID: Google Cloud Project ID with Earth Engine API enabled
GEE_PROJECT_ID=""

# --- NOTIFICATIONS & TRANSACTIONAL ALERTING ---
# SMTP_HOST: Hostname for transactional email gateway
SMTP_HOST="smtp.gov.in"
SMTP_PORT="587"
SMTP_USER="vigilance-alerts@mospi.gov.in"
SMTP_PASS=""
# SENDGRID_API_KEY: Alternative SendGrid API key for emergency email dispatch
SENDGRID_API_KEY=""
# SMS_GATEWAY_URL: CDAC / NIC Mobile Seva SMS gateway endpoint
SMS_GATEWAY_URL="https://mgov.gov.in/api/sms/send"
# SMS_GATEWAY_API_KEY: Authorized CDAC / Telecom SMS authentication key
SMS_GATEWAY_API_KEY=""
# SMS_SENDER_ID: 6-character TRAI approved Sender ID (e.g., MOSPIN)
SMS_SENDER_ID="MOSPIN"
# VIGILANCE_WEBHOOK_URL: Webhook URL for forwarding critical alerts to SIEM / Command Room
VIGILANCE_WEBHOOK_URL=""

# --- PERSISTENT STORAGE ---
# SQLITE_DB_PATH: Path to persistent SQLite database file
SQLITE_DB_PATH="./data/mplads_vault.db"
# DATABASE_URL: Optional Postgres connection URL for high-throughput deployment
DATABASE_URL=""
