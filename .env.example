# Public frontend API base URL.
# Leave blank when Express serves both the frontend and API from the same origin.
# For GitHub Pages/static hosting, set this to the deployed backend URL.
# Example: https://mplads-api.example.com
VITE_API_BASE_URL=""

# Backend/server configuration
PORT="3000"
APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
DB_PATH="./data/mplads_store.json"

# AI service. Keep this SERVER-SIDE only; never expose it in client code.
GEMINI_API_KEY=""

# Authentication secret. Generate a strong random value in production.
JWT_SECRET="replace_with_a_secure_random_256_bit_secret_in_production"
